# API (prefix ATC_) — copy to apps/api/.env for local development.
ATC_ENV=dev
ATC_DATABASE_URL=postgresql+psycopg://atc:atc@localhost:5432/atc
ATC_REDIS_URL=redis://localhost:6379/0
ATC_S3_ENDPOINT_URL=http://localhost:9000
ATC_S3_ACCESS_KEY=minioadmin
ATC_S3_SECRET_KEY=minioadmin
ATC_S3_BUCKET=atc-documents
ATC_AUTH_MODE=dev
ATC_SESSION_SECRET=dev-only-secret-change-me
ATC_WEB_ORIGIN=http://localhost:3000
# ATC_WORKOS_API_KEY=
# ATC_WORKOS_CLIENT_ID=
# ATC_SENTRY_DSN=

# AI providers — "local" = deterministic dev/test stand-ins (no keys needed).
ATC_EMBEDDING_PROVIDER=local
# ATC_EMBEDDING_PROVIDER=voyage
# ATC_VOYAGE_API_KEY=
# ATC_ANTHROPIC_API_KEY=
# ATC_LLM_MODEL=claude-sonnet-5

# Web — copy to apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=dev
